<?xml version="1.0"?>

<model>
  <name>boat_real</name>
  <version>1.0</version>

  <sdf version="1.9">
    model.sdf
  </sdf>

  <author>
    <name>Song</name>
    <email>song@example.com</email>
  </author>

  <description>
    Simplified catamaran USV matching the team's real competition boat
    (1.20 m L x 0.85 m W x ~0.45 m H). Two buoyant demi-hulls + deck.
    Interface keeps the WAM-V conventions: model is included with
    <name>wamv</name>, command topics /wamv/thrusters/{left,right}/thrust (N),
    pose read via /world/plan_world/pose/info (name = wamv).
  </description>
</model>
