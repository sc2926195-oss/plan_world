<?xml version="1.0"?>

<model>
  <name>port_berth</name>
  <version>1.0</version>

  <sdf version="1.9">
    model.sdf
  </sdf>

  <author>
    <name>Song</name>
    <email>song@example.com</email>
  </author>

  <description>
    Floating U-shaped berth (dock slip). Local origin is the berth centre;
    the entrance/opening faces local +Y. Inner berth is slightly larger
    than the WAM-V (5.0 m wide x 7.0 m deep). Deck floats at water level.
  </description>
</model>
