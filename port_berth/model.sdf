<?xml version="1.0" ?>
<!--
  实战尺寸泊位(2026-09-10 起): U 形浮动码头
    - 内净宽 : 1.5 m (x ∈ [-0.75, +0.75])
    - 内深   : 2.0 m (y ∈ [-1.0, +1.0])
    - 墙厚   : 0.5 m, 墙高 0.5 m (z ∈ [0,0.5])
    - 开口   : 本地 +Y (朝水域/南)，后墙在本地 -Y
  本地原点 = 泊位中心；port 在世界里 yaw=π，故开口朝 -Y(南)。
-->
<sdf version="1.9">
  <model name="port_berth">
    <static>true</static>
    <self_collide>false</self_collide>

    <link name="dock">
      <!-- 后墙: y∈[101.0,101.5] (世界) -->
      <collision name="back_wall_collision">
        <pose>0 -1.25 0.25 0 0 0</pose>
        <geometry><box><size>2.5 0.5 0.5</size></box></geometry>
        <surface><friction><ode><mu>0.25</mu><mu2>0.25</mu2></ode></friction></surface>
      </collision>
      <visual name="back_wall_visual">
        <pose>0 -1.25 0.25 0 0 0</pose>
        <geometry><box><size>2.5 0.5 0.5</size></box></geometry>
        <material>
          <ambient>0.35 0.28 0.20 1</ambient>
          <diffuse>0.55 0.45 0.33 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <!-- 左墙: x∈[-1.25,-0.75] -->
      <collision name="left_wall_collision">
        <pose>-1.0 0 0.25 0 0 0</pose>
        <geometry><box><size>0.5 2.5 0.5</size></box></geometry>
        <surface><friction><ode><mu>0.25</mu><mu2>0.25</mu2></ode></friction></surface>
      </collision>
      <visual name="left_wall_visual">
        <pose>-1.0 0 0.25 0 0 0</pose>
        <geometry><box><size>0.5 2.5 0.5</size></box></geometry>
        <material>
          <ambient>0.35 0.28 0.20 1</ambient>
          <diffuse>0.55 0.45 0.33 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <!-- 右墙: x∈[+0.75,+1.25] -->
      <collision name="right_wall_collision">
        <pose>1.0 0 0.25 0 0 0</pose>
        <geometry><box><size>0.5 2.5 0.5</size></box></geometry>
        <surface><friction><ode><mu>0.25</mu><mu2>0.25</mu2></ode></friction></surface>
      </collision>
      <visual name="right_wall_visual">
        <pose>1.0 0 0.25 0 0 0</pose>
        <geometry><box><size>0.5 2.5 0.5</size></box></geometry>
        <material>
          <ambient>0.35 0.28 0.20 1</ambient>
          <diffuse>0.55 0.45 0.33 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
