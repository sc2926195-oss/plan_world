      <static>true</static>
      <pose>81.382 55.044 0.300 0 0 0.9318</pose>
      <link name="obstacle">
        <collision name="collision">
        <geometry>
          <box>
            <size>3.1623 3.1623 0.6000</size>
          </box>
        </geometry>
        </collision>
        <visual name="visual">
        <geometry>
          <box>
            <size>3.1623 3.1623 0.6000</size>
